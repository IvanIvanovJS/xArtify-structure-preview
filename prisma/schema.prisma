// art-platform/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")   
  directUrl = env("SUPABASE_DB_URL")     
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Модел за потребители - разширяваме го, за да поддържаме различни роли
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Добавяме връзките към другите модели
  passwordResetTokens  PasswordResetToken[] 
  artistProfile ArtistProfile?
  subscriptions Subscription[]
  enrollments   Enrollment[]
}
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Painting {
  id           String    @id @default(cuid())
  title        String
  description  String?
  dimensions   String?   // Например: "80x60 cm"
  materials    String?   // Например: "Маслени бои върху платно"
  images       String[]  // Масив от URL адреси на изображенията
  price        Float
  isSold       Boolean   @default(false)
  artistId     String
  artist       ArtistProfile @relation(fields: [artistId], references: [id])
  
  // Enhanced fields for filtering
  widthCm      Float?    // Width in centimeters
  heightCm     Float?    // Height in centimeters
  slug         String?   @unique // SEO-friendly URL slug
  technique    String?   // Painting technique (oil, acrylic, watercolor, etc.)
  subject      String?   // Subject matter (portrait, landscape, abstract, etc.)
  tags         String[]  // Array of tag strings for filtering
  style        String?   // Art style (realism, impressionism, abstract, etc.)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@index([technique])
  @@index([subject])
  @@index([style])
  @@index([price])
  @@index([createdAt])
  @@index([widthCm, heightCm])
}

model ArtistProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  bio          String?
  user         User      @relation(fields: [userId], references: [id]) // Релация обратно към User
  phoneNumber  String?
  paintings    Painting[]
  tags         Tag[]     // Релация към таговете на автора
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Модел за курсове
model Course {
  id            String    @id @default(cuid())
  title         String
  description   String?
  price         Float
  videoUrls     String[]   // Масив от URL-и към видеоклиповете
  materials     Material[]
  enrollments   Enrollment[]
}

// Модел за материали (продукти в нишовия магазин)
model Material {
  id            String    @id @default(cuid())
  name          String
  description   String?
  price         Float
  imageUrl      String?
  courses       Course[]
}

// Модел за абонаменти (за курсове или за художници)
model Subscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  planId        String    // ID на плана за абонамент
  status        String    // Активен, изтекъл и т.н.
  startDate     DateTime  @default(now())
  endDate       DateTime?
}

// Модел за записване в курс
model Enrollment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  isCompleted   Boolean   @default(false)
}

// Модел за контент (за editable текстове)
model Content {
  id        String   @id @default(cuid())
  key       String   @unique // Уникален ключ за идентифициране на контента
  title     String?
  subtitle  String?
  content   String?  @db.Text // За по-дълъг контент
  image1Url String?  // URL на първото изображение
  image2Url String?  // URL на второто изображение
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Модел за тагове на авторите
model Tag {
  id           String    @id @default(cuid())
  name         String    // Името на тага
  artistId     String    // ID на автора, който създава тага
  artist       ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@unique([name, artistId]) // Един автор не може да има два еднакви тага
  @@index([artistId])
  @@index([createdAt])
}

// Добавяме enum за ролите на потребителите
enum Role {
  USER
  ARTIST
  ADMIN
}