// art-platform/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Модел за потребители - разширяваме го, за да поддържаме различни роли
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Добавяме връзките към другите модели
  artistProfile ArtistProfile?
  subscriptions Subscription[]
  enrollments   Enrollment[] // <-- Добавете този ред
}

// Модел за профил на художник
model ArtistProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  bio           String?   // Автобиография на художника
  paintings     Painting[]
}

// Модел за картини
model Painting {
  id            String    @id @default(cuid())
  title         String
  description   String?
  imageUrl      String?   // URL към изображението, което ще се съхранява в Cloudinary/S3
  price         Float
  isSold        Boolean   @default(false)
  artistId      String
  artist        ArtistProfile @relation(fields: [artistId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Модел за курсове
model Course {
  id            String    @id @default(cuid())
  title         String
  description   String?
  price         Float
  videoUrls     String[]   // Масив от URL-и към видеоклиповете
  materials     Material[]
  enrollments   Enrollment[]
}

// Модел за материали (продукти в нишовия магазин)
model Material {
  id            String    @id @default(cuid())
  name          String
  description   String?
  price         Float
  imageUrl      String?
  courses       Course[]
}

// Модел за абонаменти (за курсове или за художници)
model Subscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  planId        String    // ID на плана за абонамент
  status        String    // Активен, изтекъл и т.н.
  startDate     DateTime  @default(now())
  endDate       DateTime?
}

// Модел за записване в курс
model Enrollment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  isCompleted   Boolean   @default(false)
}

// Добавяме enum за ролите на потребителите
enum Role {
  USER
  ARTIST
  ADMIN
}