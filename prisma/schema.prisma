// art-platform/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")   
  directUrl = env("SUPABASE_DB_URL")     
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Модел за потребители - разширяваме го, за да поддържаме различни роли
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Добавяме връзките към другите модели
  passwordResetTokens  PasswordResetToken[] 
  artistProfile ArtistProfile?
  subscriptions Subscription[]
  enrollments   Enrollment[]
  favorites     Favorite[]
  purchases     Sale[]
  conversations Conversation[]
}
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Painting {
  id           String    @id @default(cuid())
  title        String
  urlTitle     String    @unique // SEO-friendly URL title for better crawling
  description  String?
  dimensions   String?   // Например: "80x60 cm"
  materials    String?   // Например: "Маслени бои върху платно"
  images       String[]  // Масив от URL адреси на изображенията
  price        Float
  isSold       Boolean   @default(false)
  artistId     String
  artist       ArtistProfile @relation(fields: [artistId], references: [id])
  
  // Enhanced fields for filtering
  widthCm      Float     // Width in centimeters (required)
  heightCm     Float     // Height in centimeters (required)
  slug         String?   @unique // SEO-friendly URL slug
  technique    String?   // Painting technique (oil, acrylic, watercolor, etc.)
  subject      String?   // Subject matter (portrait, landscape, abstract, etc.)
  tags         String[]  // Array of tag strings for filtering
  style        String?   // Art style (realism, impressionism, abstract, etc.)
  
  // Sale fields
  isOnSale     Boolean   @default(false)  // Whether the painting is on sale
  salePercentage Float?  // Sale percentage (1-100)
  finalPrice   Float?    // Final price after sale calculation (price user wants to receive)
  originalPrice Float?   // Original price before discount (calculated from final price and percentage)
  
  // New fields
  status       String    @default("published") // draft|published
  views        PaintingView[]
  sales        Sale[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Relations
  favorites    Favorite[]
  
  @@index([technique])
  @@index([subject])
  @@index([style])
  @@index([price])
  @@index([createdAt])
  @@index([widthCm, heightCm])
  @@index([isOnSale])
  @@index([finalPrice])
  @@index([originalPrice])
  @@index([urlTitle])
  @@index([status])
}

model ArtistProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  bio          String?   @db.Text
  user         User      @relation(fields: [userId], references: [id]) // Релация обратно към User
  phoneNumber  String?
  birthDate    DateTime?
  showBirthDate Boolean  @default(false)
  country      String?
  city         String?
  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  
  // Social media and contact info
  website      String?
  instagram    String?
  facebook     String?
  twitter      String?
  location     String?
  
  // Professional info
  specialties  String[]  @default([])
  experience   String?   @db.Text
  education    String?   @db.Text
  awards       String?   @db.Text
  
  paintings    Painting[]
  tags         Tag[]     // Релация към таговете на автора
  faqs         ArtistFAQ[] // Често задавани въпроси
  subscription ArtistSubscription?
  courses      Course[]
  profileViews ProfileView[]
  sales        Sale[]
  conversations Conversation[]
  emailNotifications    Boolean @default(true)
  messageNotifications  Boolean @default(true)
  salesNotifications    Boolean @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Модел за курсове
model Course {
  id          String    @id @default(cuid())
  title       String
  description String?
  price       Float
  videoUrls   String[]
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  materials   Material[]
  enrollments Enrollment[]
  thumbnailUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([artistId])
}

// Модел за материали (продукти в нишовия магазин)
model Material {
  id            String    @id @default(cuid())
  name          String
  description   String?
  price         Float
  imageUrl      String?
  courses       Course[]
}

// Модел за абонаменти (за курсове или за художници)
model Subscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  planId        String    // ID на плана за абонамент
  status        String    // Активен, изтекъл и т.н.
  startDate     DateTime  @default(now())
  endDate       DateTime?
}

// Модел за планове за абонаменти на артисти
model SubscriptionPlan {
  id                String    @id @default(cuid())
  name              String    // "Free", "Medium", "High"
  displayName       String    // "Безплатен", "Среден", "Висок"
  description       String    @db.Text
  monthlyPrice      Float     // Цена за месец в евро
  yearlyPrice       Float     // Цена за година в евро
  yearlyDiscount    Float     @default(0.2) // 20% отстъпка за годишен абонамент
  maxActivePaintings Int      // Максимален брой активни картини
  commissionRate    Float     // Комисионна от продажба (0.3 = 30%)
  analyticsAccess   String    // "minimal", "extended", "full"
  advertisingPriority String  // "low", "high", "very_high"
  directCommunication Boolean @default(false)
  emailPromotions   Boolean   @default(false)
  notifications     Boolean   @default(false)
  unlimitedUploads  Boolean   @default(false)
  isActive          Boolean   @default(true)
  stripePriceId     String?   // Stripe Price ID за месечен абонамент
  stripeYearlyPriceId String? // Stripe Price ID за годишен абонамент
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  artistSubscriptions ArtistSubscription[]
  
  @@unique([name])
}

// Модел за абонаменти на артисти
model ArtistSubscription {
  id                String    @id @default(cuid())
  artistId          String    @unique
  planId            String
  artist            ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  status            String    // "active", "cancelled", "expired", "past_due", "pending"
  billingCycle      String    // "monthly", "yearly"
  stripeSubscriptionId String? // Stripe Subscription ID
  stripeCustomerId  String?   // Stripe Customer ID
  paymentIntentId   String?   // Payment Intent ID for one-time payments
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
}

// Модел за съхранение на информация за плащания
model PaymentIntent {
  id            String    @id @default(cuid())
  userId        String
  planId        String
  billingCycle  String    // "monthly", "yearly"
  amount        Int       // Amount in cents
  currency      String    @default("eur")
  status        String    // "succeeded", "failed", "pending"
  metadata      Json?     // Additional metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("payment_intents")
}

// Модел за често задавани въпроси на артисти
model ArtistFAQ {
  id        String    @id @default(cuid())
  artistId  String
  question  String    @db.Text
  answer    String    @db.Text
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@index([artistId])
}

// Модел за записване в курс
model Enrollment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  isCompleted   Boolean   @default(false)
}

// Модел за контент (за editable текстове)
model Content {
  id        String   @id @default(cuid())
  key       String   @unique // Уникален ключ за идентифициране на контента
  title     String?
  subtitle  String?
  content   String?  @db.Text // За по-дълъг контент
  image1Url String?  // URL на първото изображение
  image2Url String?  // URL на второто изображение
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Модел за тагове на авторите
model Tag {
  id           String    @id @default(cuid())
  name         String    // Името на тага
  artistId     String    // ID на автора, който създава тага
  artist       ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@unique([name, artistId]) // Един автор не може да има два еднакви тага
  @@index([artistId])
  @@index([createdAt])
}

// Модел за любими картини
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  paintingId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  painting   Painting @relation(fields: [paintingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  
  @@unique([userId, paintingId])
  @@index([userId])
  @@index([paintingId])
  @@map("favorites")
}

// Analytics models
model PaintingView {
  id         String   @id @default(cuid())
  paintingId String
  painting   Painting @relation(fields: [paintingId], references: [id], onDelete: Cascade)
  userId     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([paintingId])
  @@index([createdAt])
  @@map("painting_views")
}

model ProfileView {
  id        String   @id @default(cuid())
  artistId  String
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([artistId])
  @@index([createdAt])
  @@map("profile_views")
}

model Sale {
  id               String   @id @default(cuid())
  paintingId       String
  painting         Painting @relation(fields: [paintingId], references: [id])
  artistId         String
  artist           ArtistProfile @relation(fields: [artistId], references: [id])
  buyerId          String
  buyer            User @relation(fields: [buyerId], references: [id])
  salePrice        Float
  commissionRate   Float
  commissionAmount Float
  stripePaymentId  String?
  status           String   // pending|completed|refunded
  createdAt        DateTime @default(now())
  completedAt      DateTime?
  @@index([artistId])
  @@index([paintingId])
  @@index([createdAt])
  @@map("sales")
}

// Messaging models
model Conversation {
  id               String   @id @default(cuid())
  userId           String
  artistId         String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist           ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  lastMessageAt    DateTime @default(now())
  userUnreadCount  Int @default(0)
  artistUnreadCount Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  messages         Message[]
  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderType     String   // USER|ARTIST
  content        String   @db.Text
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

// Добавяме enum за ролите на потребителите
enum Role {
  USER
  ARTIST
  ADMIN
}